# ─── Environment Variables: Lotus Semarang ───

# Production Site URL
NEXT_PUBLIC_SITE_URL=https://www.lotussemarang.com

# Google Tag Manager (GTM) Container ID (Recommended)
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 (GA4) Measurement ID (Fallback if not using GTM)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (content="..." value only).
# Optional if the property is verified via DNS (recommended: Domain property).
NEXT_PUBLIC_GSC_VERIFICATION=
